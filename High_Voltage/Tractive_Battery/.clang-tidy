---
# clang-tidy rules for Tractive Battery (C firmware: STM32 + FreeRTOS).
# Overrides the repo-root .clang-tidy (C++-oriented) for files under this folder.
#
# Off and why:
#   boost-*, modernize-*, cppcoreguidelines-*  C++-only rule sets
#   bugprone-easily-swappable-parameters       flags every clamp(value, min, max)
#   clang-analyzer-core.FixedAddressDereference,
#   performance-no-int-to-ptr                  memory-mapped peripheral registers (GPIOC, RCC, ...)
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#                                              suggests memcpy_s, which newlib doesn't provide
#   readability-magic-numbers                  register values, CAN scale factors, bit masks
#   readability-identifier-length              i, v, id in loops and math
#   readability-uppercase-literal-suffix       1.0f vs 1.0F is cosmetic
#   readability-redundant-declaration          externs CubeMX writes into generated files
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  performance-*,
  -performance-no-int-to-ptr,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-uppercase-literal-suffix,
  -readability-redundant-declaration
WarningsAsErrors: ''
FormatStyle: file
CheckOptions:
  # State machines and CubeMX MSP init functions exceed the default 25 by design
  - key: readability-function-cognitive-complexity.Threshold
    value: 50
